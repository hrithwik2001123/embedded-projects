--cpu=Cortex-M4.fp.sp
"lcd3\startup_stm32f401xc.o"
"lcd3\main.o"
"lcd3\stm32f4xx_it.o"
"lcd3\stm32f4xx_hal_msp.o"
"lcd3\stm32f4xx_hal_i2c.o"
"lcd3\stm32f4xx_hal_i2c_ex.o"
"lcd3\stm32f4xx_hal_rcc.o"
"lcd3\stm32f4xx_hal_rcc_ex.o"
"lcd3\stm32f4xx_hal_flash.o"
"lcd3\stm32f4xx_hal_flash_ex.o"
"lcd3\stm32f4xx_hal_flash_ramfunc.o"
"lcd3\stm32f4xx_hal_gpio.o"
"lcd3\stm32f4xx_hal_dma_ex.o"
"lcd3\stm32f4xx_hal_dma.o"
"lcd3\stm32f4xx_hal_pwr.o"
"lcd3\stm32f4xx_hal_pwr_ex.o"
"lcd3\stm32f4xx_hal_cortex.o"
