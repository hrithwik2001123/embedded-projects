--cpu=Cortex-M4.fp.sp
"blink3\startup_stm32f401xc.o"
"blink3\main.o"
"blink3\stm32f4xx_it.o"
"blink3\stm32f4xx_hal_msp.o"
"blink3\stm32f4xx_hal_rcc.o"
"blink3\stm32f4xx_hal_rcc_ex.o"
"blink3\stm32f4xx_hal_flash.o"
"blink3\stm32f4xx_hal_flash_ex.o"
"blink3\stm32f4xx_hal_flash_ramfunc.o"
"blink3\stm32f4xx_hal_gpio.o"
"blink3\stm32f4xx_hal_dma_ex.o"
"blink3\stm32f4xx_hal_dma.o"
"blink3\stm32f4xx_hal_pwr.o"
"blink3\stm32f4xx_hal_pwr_ex.o"
"blink3\stm32f4xx_hal_cortex.o"
"blink3\stm32f4xx_hal.o"
"blink3\stm32f4xx_hal_exti.o"
"blink3\system_stm32f4xx.o"
--strict --scatter "blink3\blink3.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "blink3.map" -o blink3\blink3.axf